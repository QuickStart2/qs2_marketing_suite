<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_whatsapp_poll" model="ir.cron">
        <field name="name">WhatsApp: ricevi messaggi</field>
        <field name="model_id" ref="model_whatsapp_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_messages()</field>
        <field name="interval_number">1</field>
