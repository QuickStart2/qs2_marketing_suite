<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="whatsapp_test_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.test.message.wizard.form</field>
        <field name="model">whatsapp.test.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Invia messaggio di test">
                <group>
                    <field name="account_id" invisible="1"/>
                    <field name="phone" placeholder="+39328..."/>
                    <field name="message"/>
                </group>
                <footer>
                    <button name="action_send" type="object"
                            string="Invia" class="btn-primary"/>
                    <button string="Annulla" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
