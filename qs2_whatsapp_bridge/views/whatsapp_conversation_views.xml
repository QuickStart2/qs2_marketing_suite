<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="whatsapp_conversation_list" model="ir.ui.view">
        <field name="name">whatsapp.conversation.list</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <list string="Conversazioni WhatsApp" default_order="last_message_date desc">
                <field name="display_name"/>
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="last_message_date"/>
                <field name="last_message_preview"/>
                <field name="unread_count" widget="badge"
                       decoration-info="unread_count > 0"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">whatsapp.conversation.form</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversazione WhatsApp">
                <sheet>
                    <group>
                        <group>
                            <field name="display_name"/>
                            <field name="phone"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="wa_jid"/>
                            <field name="service_id" invisible="not service_id"/>
                            <field name="last_message_date"/>
                            <field name="unread_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Messaggi">
                            <field name="message_ids">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="direction"/>
                                    <field name="body"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'delivered'"
                                           decoration-info="state == 'sent'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action conversazioni -->
    <record id="action_whatsapp_conversation" model="ir.actions.act_window">
        <field name="name">Conversazioni</field>
        <field name="res_model">whatsapp.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Client action — chat WhatsApp style -->
    <record id="action_whatsapp_chat" model="ir.actions.client">
        <field name="name">WhatsApp Chat</field>
        <field name="tag">qs2_whatsapp_bridge.chat</field>
    </record>

</odoo>
