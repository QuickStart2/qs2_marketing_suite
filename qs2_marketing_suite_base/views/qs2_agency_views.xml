<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="qs2_agency_form" model="ir.ui.view">
        <field name="name">qs2.agency.form</field>
        <field name="model">qs2.agency</field>
        <field name="arch" type="xml">
            <form string="Agenzia Marketing">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nome agenzia"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Note..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qs2_agency_list" model="ir.ui.view">
        <field name="name">qs2.agency.list</field>
        <field name="model">qs2.agency</field>
        <field name="arch" type="xml">
            <list string="Agenzie Marketing">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="website" widget="url"/>
            </list>
        </field>
    </record>

    <record id="action_qs2_agency" model="ir.actions.act_window">
        <field name="name">Agenzie</field>
        <field name="res_model">qs2.agency</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
