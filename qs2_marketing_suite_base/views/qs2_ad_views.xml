<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inserzione — Kanban -->
    <record id="qs2_ad_kanban" model="ir.ui.view">
        <field name="name">qs2.ad.kanban</field>
        <field name="model">qs2.ad</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="media_type"/>
                <field name="platform"/>
                <field name="image"/>
                <field name="campaign_id"/>
                <field name="source_id"/>
                <field name="brand_id"/>
                <field name="platform_ref"/>
                <field name="url"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-if="record.image.raw_value"
                                 t-attf-src="/web/image/qs2.ad/{{ record.id.raw_value }}/image"
                                 alt="Ad" class="o_image_64_cover"/>
                            <div t-else="" class="o_kanban_image_default d-flex align-items-center justify-content-center bg-200"
                                 style="width:64px;height:64px;">
                                <i t-if="record.media_type.raw_value == 'image'"
                                   class="fa fa-image fa-2x text-muted"
                                   title="Foto"/>
                                <i t-elif="record.media_type.raw_value == 'video'"
                                   class="fa fa-play-circle fa-2x text-muted"
                                   title="Video"/>
                                <i t-else="" class="fa fa-font fa-2x text-muted"
                                   title="Testo"/>
                            </div>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted small">
                                <field name="campaign_id"/> -
                                <field name="source_id"/>
                            </div>
                            <div class="text-muted small" t-if="record.brand_id.raw_value">
                                <i class="fa fa-tag"/> <field name="brand_id"/>
                            </div>
                            <div class="mt-1 d-flex gap-1">
                                <span t-if="record.media_type.raw_value == 'image'"
                                      class="badge text-bg-info">Foto</span>
                                <span t-elif="record.media_type.raw_value == 'video'"
                                      class="badge text-bg-danger">Video</span>
                                <span t-else="" class="badge text-bg-secondary">Testo</span>
                                <span t-if="record.platform.raw_value"
                                      class="badge text-bg-dark">
                                    <field name="platform"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1"
                                 t-if="record.platform_ref.raw_value">
                                <i class="fa fa-hashtag"/>
                                <field name="platform_ref"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Inserzione — Form -->
    <record id="qs2_ad_form" model="ir.ui.view">
        <field name="name">qs2.ad.form</field>
        <field name="model">qs2.ad</field>
        <field name="arch" type="xml">
            <form string="Inserzione">
                <sheet>
                    <div class="d-flex gap-4 mb-3 align-items-start">
                        <field name="image" widget="image"
                               options="{'size': [420, 420], 'preview_image': 'image'}"
                               class="qs2_ad_form_image"/>
                        <div class="flex-grow-1">
                            <div class="oe_title">
                                <h1><field name="name" placeholder="Nome inserzione"/></h1>
                            </div>
                            <group>
                                <group string="Dettagli">
                                    <field name="media_plan_id"/>
                                    <field name="media_type"/>
                                    <field name="platform"/>
                                    <field name="platform_ref" placeholder="es. 120215364789"/>
                                    <field name="url" widget="url" placeholder="https://..."/>
                                </group>
                                <group string="Riferimenti">
                                    <field name="campaign_id" readonly="1"/>
                                    <field name="source_id" readonly="1"/>
                                    <field name="brand_id" readonly="1"/>
                                </group>
                            </group>
                        </div>
                    </div>
                    <group>
                        <field name="note" placeholder="Note..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inserzione — List -->
    <record id="qs2_ad_list" model="ir.ui.view">
        <field name="name">qs2.ad.list</field>
        <field name="model">qs2.ad</field>
        <field name="arch" type="xml">
            <list string="Inserzioni">
                <field name="name"/>
                <field name="platform"/>
                <field name="media_type"/>
                <field name="campaign_id"/>
                <field name="source_id"/>
                <field name="brand_id" optional="show"/>
                <field name="platform_ref" optional="show"/>
                <field name="url" widget="url" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Inserzione — Search -->
    <record id="qs2_ad_search" model="ir.ui.view">
        <field name="name">qs2.ad.search</field>
        <field name="model">qs2.ad</field>
        <field name="arch" type="xml">
            <search string="Inserzioni">
                <field name="name"/>
                <field name="platform_ref"/>
                <field name="campaign_id"/>
                <field name="source_id"/>
                <field name="brand_id"/>
                <separator/>
                <filter name="filter_image" string="Foto"
                        domain="[('media_type', '=', 'image')]"/>
                <filter name="filter_video" string="Video"
                        domain="[('media_type', '=', 'video')]"/>
                <filter name="filter_text" string="Testo"
                        domain="[('media_type', '=', 'text')]"/>
                <separator/>
                <filter name="filter_meta" string="Meta"
                        domain="[('platform', '=', 'meta')]"/>
                <filter name="filter_google" string="Google"
                        domain="[('platform', '=', 'google')]"/>
                <filter name="filter_tiktok" string="TikTok"
                        domain="[('platform', '=', 'tiktok')]"/>
                <separator/>
                <group>
                    <filter name="group_platform" string="Piattaforma"
                            context="{'group_by': 'platform'}"/>
                    <filter name="group_media_type" string="Tipo Media"
                            context="{'group_by': 'media_type'}"/>
                    <filter name="group_campaign" string="Campagna"
                            context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_brand" string="Brand"
                            context="{'group_by': 'brand_id'}"/>
                    <filter name="group_plan" string="Piano Media"
                            context="{'group_by': 'media_plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Inserzione — Action -->
    <record id="action_qs2_ad" model="ir.actions.act_window">
        <field name="name">Inserzioni</field>
        <field name="res_model">qs2.ad</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>
