<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form lead: campi marketing rapidi a fianco di source_id + tab dedicato. -->
    <record id="crm_lead_view_form_inherit_marketing_suite" model="ir.ui.view">
        <field name="name">crm.lead.form.marketing.suite</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Rating a stelle nell'header — sempre visibile, sopra al titolo lead. -->
            <xpath expr="//field[@name='priority']" position="after">
                <field name="qs2_rating" widget="priority" nolabel="1"/>
            </xpath>

            <!-- Campi marketing rapidi accanto a source_id (mantieniti compatibilità). -->
            <xpath expr="//field[@name='source_id'][1]" position="after">
                <field name="qs2_agency_id"/>
                <field name="qs2_initiative"/>
                <field name="qs2_ad_id"
                       domain="[('campaign_id', '=', campaign_id)]"
                       context="{'default_media_plan_id': False}"/>
                <field name="qs2_media_plan_id" readonly="1"/>
                <field name="qs2_brand_id" readonly="1"/>
            </xpath>

            <!-- Tab Marketing Insights — pannello coeso con frame creatività + rating + criteri. -->
            <xpath expr="//notebook" position="inside">
                <page string="Marketing Insights" name="qs2_marketing_insights">
                    <group>
                        <group string="Filiera">
                            <field name="qs2_brand_id" readonly="1"/>
                            <field name="qs2_agency_id"/>
                            <field name="qs2_initiative"/>
                            <field name="campaign_id"/>
                            <field name="source_id"/>
                            <field name="medium_id"/>
                            <field name="qs2_ad_id"
                                   domain="[('campaign_id', '=', campaign_id)]"/>
                            <field name="qs2_media_plan_id" readonly="1"/>
                        </group>
                        <group string="Creatività vista dal contatto">
                            <field name="qs2_ad_image"
                                   widget="image"
                                   options="{'size': [240, 240]}"
                                   nolabel="1"
                                   invisible="not qs2_ad_id"/>
                            <div invisible="qs2_ad_id" colspan="2"
                                 class="text-muted fst-italic">
                                Nessuna inserzione collegata — seleziona un'inserzione
                                qui sopra per vedere il frame.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Rating qualità lead">
                            <field name="qs2_rating" widget="priority"/>
                            <field name="qs2_rating_matched_ids"
                                   widget="many2many_tags"
                                   readonly="1"
                                   string="Criteri soddisfatti"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Aggiunge colonne nella lista lead -->
    <record id="crm_lead_view_list_inherit_marketing_suite" model="ir.ui.view">
        <field name="name">crm.lead.list.marketing.suite</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="qs2_agency_id" optional="hide"/>
                <field name="qs2_initiative" optional="hide"/>
                <field name="qs2_ad_id" optional="hide"/>
                <field name="qs2_brand_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
