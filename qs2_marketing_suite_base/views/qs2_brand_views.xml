<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brand — Form -->
    <record id="qs2_brand_form" model="ir.ui.view">
        <field name="name">qs2.brand.form</field>
        <field name="model">qs2.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <field name="logo" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nome brand"/></h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="note" placeholder="Note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Brand — List -->
    <record id="qs2_brand_list" model="ir.ui.view">
        <field name="name">qs2.brand.list</field>
        <field name="model">qs2.brand</field>
        <field name="arch" type="xml">
            <list string="Brand">
                <field name="name"/>
                <field name="media_plan_count" string="Piani Media"/>
            </list>
        </field>
    </record>

    <!-- Brand — Action -->
    <record id="action_qs2_brand" model="ir.actions.act_window">
        <field name="name">Brand</field>
        <field name="res_model">qs2.brand</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
