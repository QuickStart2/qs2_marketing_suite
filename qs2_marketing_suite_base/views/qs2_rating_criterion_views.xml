<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="qs2_rating_criterion_list" model="ir.ui.view">
        <field name="name">qs2.lead.rating.criterion.list</field>
        <field name="model">qs2.lead.rating.criterion</field>
        <field name="arch" type="xml">
            <list string="Criteri di rating lead" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="field_name"/>
                <field name="expected_value"/>
                <field name="domain"/>
                <field name="weight"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="qs2_rating_criterion_form" model="ir.ui.view">
        <field name="name">qs2.lead.rating.criterion.form</field>
        <field name="model">qs2.lead.rating.criterion</field>
        <field name="arch" type="xml">
            <form string="Criterio di rating">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="weight"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="kind"/>
                            <field name="field_name"
                                   invisible="kind == 'domain'"
                                   required="kind != 'domain'"/>
                            <field name="expected_value"
                                   invisible="kind != 'equals'"/>
                            <field name="domain"
                                   invisible="kind != 'domain'"/>
                        </group>
                    </group>
                    <group string="Descrizione">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qs2_rating_criterion" model="ir.actions.act_window">
        <field name="name">Criteri rating lead</field>
        <field name="res_model">qs2.lead.rating.criterion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qs2_rating_criterion"
              name="Criteri rating lead"
              parent="menu_marketing_config"
              action="action_qs2_rating_criterion"
              sequence="30"/>

</odoo>
