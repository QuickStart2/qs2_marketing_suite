<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_notification_app_view_list" model="ir.ui.view">
        <field name="name">mail.notification.app.list</field>
        <field name="model">mail.notification</field>
        <field name="arch" type="xml">
            <list string="Consegne App" create="false" edit="false">
                <field name="mail_message_id"/>
                <field name="res_partner_id"/>
                <field name="author_id" optional="hide"/>
                <field name="notification_status" widget="badge"
                       decoration-success="notification_status == 'sent'"
                       decoration-warning="notification_status in ('ready', 'process', 'pending')"
                       decoration-danger="notification_status in ('bounce', 'exception')"/>
                <field name="read_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mail_notification_app_view_search" model="ir.ui.view">
        <field name="name">mail.notification.app.search</field>
        <field name="model">mail.notification</field>
        <field name="arch" type="xml">
            <search string="Consegne App">
                <field name="res_partner_id"/>
                <field name="mail_message_id"/>
                <filter name="filter_pending" string="Da consegnare"
                        domain="[('notification_status', 'in', ('ready', 'process', 'pending'))]"/>
                <filter name="filter_sent" string="Consegnate"
                        domain="[('notification_status', '=', 'sent')]"/>
                <separator/>
                <filter name="group_status" string="Stato"
                        context="{'group_by': 'notification_status'}"/>
                <filter name="group_partner" string="Destinatario"
                        context="{'group_by': 'res_partner_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_app_notifications" model="ir.actions.act_window">
        <field name="name">Consegne App</field>
        <field name="res_model">mail.notification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('notification_type', '=', 'app')]</field>
        <field name="view_id" ref="mail_notification_app_view_list"/>
        <field name="search_view_id" ref="mail_notification_app_view_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
