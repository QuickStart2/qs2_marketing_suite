<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qs2_app_distribution_list_view_form" model="ir.ui.view">
        <field name="name">qs2.app.distribution.list.form</field>
        <field name="model">qs2.app.distribution.list</field>
        <field name="arch" type="xml">
            <form string="Lista di distribuzione">
                <sheet>
                    <widget name="web_ribbon" title="Archiviata" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Es. Tecnici sul campo"/></h1>
                    </div>
                    <group>
                        <field name="member_count"/>
                    </group>
                    <notebook>
                        <page name="members" string="Membri">
                            <field name="user_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="email"/>
                                    <field name="share" string="Portale" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="note" string="Note">
                            <field name="note" placeholder="Note interne sulla lista..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qs2_app_distribution_list_view_list" model="ir.ui.view">
        <field name="name">qs2.app.distribution.list.list</field>
        <field name="model">qs2.app.distribution.list</field>
        <field name="arch" type="xml">
            <list string="Liste di distribuzione">
                <field name="name"/>
                <field name="member_count"/>
            </list>
        </field>
    </record>

    <record id="action_qs2_app_distribution_list" model="ir.actions.act_window">
        <field name="name">Liste di distribuzione</field>
        <field name="res_model">qs2.app.distribution.list</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea una lista di distribuzione</p>
            <p>Raggruppa gli utenti destinatari per inviare loro messaggi in un colpo solo.</p>
        </field>
    </record>
</odoo>
