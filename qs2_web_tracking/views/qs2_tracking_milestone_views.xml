<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Milestone                                                     -->
    <!-- ============================================================ -->
    <record id="qs2_tracking_milestone_list" model="ir.ui.view">
        <field name="name">qs2.tracking.milestone.list</field>
        <field name="model">qs2.tracking.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestone tracking" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="partner_count"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_qs2_tracking_milestone" model="ir.actions.act_window">
        <field name="name">Milestone tracking</field>
        <field name="res_model">qs2.tracking.milestone</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qs2_tracking_milestone"
              name="Milestone tracking"
              parent="crm.crm_menu_config"
              action="action_qs2_tracking_milestone"
              sequence="60"/>

    <!-- ============================================================ -->
    <!-- Rules                                                         -->
    <!-- ============================================================ -->
    <record id="qs2_tracking_rule_list" model="ir.ui.view">
        <field name="name">qs2.tracking.rule.list</field>
        <field name="model">qs2.tracking.rule</field>
        <field name="arch" type="xml">
            <list string="Regole URL → milestone" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url_pattern"/>
                <field name="is_regex"/>
                <field name="milestone_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_qs2_tracking_rule" model="ir.actions.act_window">
        <field name="name">Regole URL tracking</field>
        <field name="res_model">qs2.tracking.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qs2_tracking_rule"
              name="Regole URL tracking"
              parent="crm.crm_menu_config"
              action="action_qs2_tracking_rule"
              sequence="61"/>

    <!-- ============================================================ -->
    <!-- res.partner: pulsante e M2M milestone                         -->
    <!-- ============================================================ -->
    <record id="res_partner_view_form_tracking_milestone" model="ir.ui.view">
        <field name="name">res.partner.form.qs2.tracking.milestone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="qs2_web_tracking.view_partner_form_tracking"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qs2_tracking_code']" position="after">
                <field name="qs2_milestone_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>

</odoo>
