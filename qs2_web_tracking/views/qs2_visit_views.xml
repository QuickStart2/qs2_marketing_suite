<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="qs2_visit_list" model="ir.ui.view">
        <field name="name">qs2.visit.list</field>
        <field name="model">qs2.visit</field>
        <field name="arch" type="xml">
            <list string="Visite Web" default_order="timestamp desc"
                  create="false" edit="false">
                <field name="timestamp"/>
                <field name="partner_id"/>
                <field name="url" widget="url"/>
                <field name="ip_address"/>
                <field name="referer"/>
                <field name="session_id"/>
            </list>
        </field>
    </record>

    <record id="qs2_visit_form" model="ir.ui.view">
        <field name="name">qs2.visit.form</field>
        <field name="model">qs2.visit</field>
        <field name="arch" type="xml">
            <form string="Visita Web" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="url" widget="url"/>
                            <field name="timestamp"/>
                        </group>
                        <group>
                            <field name="ip_address"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group string="Dettagli">
                        <field name="user_agent"/>
                        <field name="referer" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="qs2_visit_search" model="ir.ui.view">
        <field name="name">qs2.visit.search</field>
        <field name="model">qs2.visit</field>
        <field name="arch" type="xml">
            <search string="Cerca Visite">
                <field name="partner_id"/>
                <field name="url"/>
                <field name="ip_address"/>
                <group>
                    <filter name="group_partner" string="Contatto"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Data"
                            context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qs2_visit" model="ir.actions.act_window">
        <field name="name">Visite Web</field>
        <field name="res_model">qs2.visit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qs2_visit"
              name="Visite Web"
              parent="crm.crm_menu_config"
              action="action_qs2_visit"
              sequence="50"/>

</odoo>
