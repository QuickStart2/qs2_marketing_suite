<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================== -->
    <!-- Card "I miei lead" nella home del portale                    -->
    <!-- =========================================================== -->
    <template id="portal_my_home_lead" name="Portal My Home: Lead"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/portal/static/src/img/portal-addresses.svg'"/>
                <t t-set="title">I miei lead</t>
                <t t-set="text">Consulta e aggiorna i tuoi lead</t>
                <t t-set="url" t-value="'/my/leads'"/>
                <t t-set="placeholder_count" t-value="'lead_count'"/>
            </t>
        </xpath>
    </template>

    <!-- =========================================================== -->
    <!-- Priorità a stelle (riusabile)                                -->
    <!-- =========================================================== -->
    <template id="lead_priority_stars" name="Lead Priority Stars">
        <span class="o_lead_star" t-att-title="'Priorità'">
            <i t-attf-class="fa fa-star#{'' if lead.priority != '0' else '-o opacity-50'} text-warning"/>
            <i t-attf-class="fa fa-star#{'' if lead.priority in ['2','3'] else '-o opacity-50'} text-warning"/>
            <i t-attf-class="fa fa-star#{'' if lead.priority == '3' else '-o opacity-50'} text-warning"/>
        </span>
    </template>

    <!-- =========================================================== -->
    <!-- Card lead (riusabile nella pipeline)                         -->
    <!-- =========================================================== -->
    <template id="lead_card" name="Lead Card">
        <a class="o_leads_card" draggable="true"
           t-att-data-lead-id="lead.id"
           t-attf-href="/my/leads/#{lead.id}">
            <div class="o_leads_card_title text-truncate mb-1" t-out="lead.name or 'Lead'"/>
            <div t-if="lead.tag_ids" class="d-flex flex-wrap gap-1 mb-1">
                <t t-foreach="lead.tag_ids" t-as="tag">
                    <span class="badge rounded-pill o_tag"
                          t-attf-class="o_badge_color_#{tag.color}"
                          t-out="tag.name"/>
                </t>
            </div>
            <div t-if="lead.contact_name" class="small text-muted text-truncate" t-out="lead.contact_name"/>
            <div class="d-flex align-items-center justify-content-between mt-1">
                <t t-call="qs2_crm_portal.lead_priority_stars"/>
                <small t-if="lead.city" class="text-muted text-truncate">
                    <i class="fa fa-map-marker me-1"/><t t-out="lead.city"/>
                </small>
            </div>
        </a>
    </template>

    <!-- =========================================================== -->
    <!-- Pipeline kanban: /my/leads                                   -->
    <!-- =========================================================== -->
    <template id="portal_my_leads" name="My Leads">
        <t t-call="portal.portal_layout">
            <div class="o_portal_leads">
                <div class="row align-items-center mb-3">
                    <div class="col">
                        <h3 class="mb-0">I miei lead</h3>
                        <p class="text-muted mb-0">
                            Trascina le schede tra le colonne per cambiare fase.
                        </p>
                    </div>
                    <div class="col-auto">
                        <div class="d-flex gap-2">
                            <div class="card text-center">
                                <div class="card-body py-2 px-3">
                                    <div class="fs-4 fw-bold lh-1" t-out="lead_total"/>
                                    <div class="text-muted small">Totali</div>
                                </div>
                            </div>
                            <div class="card text-center">
                                <div class="card-body py-2 px-3">
                                    <div class="fs-4 fw-bold lh-1 text-success" t-out="lead_won"/>
                                    <div class="text-muted small">Vinti</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <t t-if="lead_total == 0">
                    <div class="alert alert-info" role="alert">
                        Non hai ancora nessun lead assegnato.
                    </div>
                </t>

                <div t-if="lead_total &gt; 0" class="o_leads_kanban">
                    <!-- Colonna "Senza fase" (non-droppable): mostra i lead senza
                         stage così il totale coincide con le card visibili -->
                    <div t-if="no_stage_leads" class="o_leads_col" style="--col-color: #a2a2a2">
                        <div class="o_leads_col_head">
                            <span class="text-truncate text-muted">Senza fase</span>
                            <span class="o_leads_col_count" t-out="len(no_stage_leads)"/>
                        </div>
                        <div class="o_leads_col_body_static">
                            <t t-foreach="no_stage_leads" t-as="lead">
                                <t t-call="qs2_crm_portal.lead_card"/>
                            </t>
                        </div>
                    </div>
                    <t t-foreach="columns" t-as="col">
                        <div class="o_leads_col" t-attf-style="--col-color: #{col['color']}">
                            <div class="o_leads_col_head">
                                <span class="text-truncate" t-out="col['stage'].name"/>
                                <span class="o_leads_col_count" t-out="len(col['leads'])"/>
                            </div>
                            <div class="o_leads_col_body" t-att-data-stage-id="col['stage'].id">
                                <t t-foreach="col['leads']" t-as="lead">
                                    <t t-call="qs2_crm_portal.lead_card"/>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- =========================================================== -->
    <!-- Dettaglio: /my/leads/<id>                                    -->
    <!-- =========================================================== -->
    <template id="portal_my_lead" name="My Lead">
        <t t-call="portal.portal_layout">
            <div class="row mb-2">
                <div class="col-12 d-flex align-items-center justify-content-between">
                    <a href="/my/leads" class="btn btn-link px-0">
                        <i class="fa fa-chevron-left me-1"/>Torna ai lead
                    </a>
                    <div class="btn-group" role="group">
                        <a t-if="prev_id" t-attf-href="/my/leads/#{prev_id}" class="btn btn-outline-secondary btn-sm" title="Precedente">
                            <i class="fa fa-chevron-left"/>
                        </a>
                        <a t-if="next_id" t-attf-href="/my/leads/#{next_id}" class="btn btn-outline-secondary btn-sm" title="Successivo">
                            <i class="fa fa-chevron-right"/>
                        </a>
                    </div>
                </div>
            </div>

            <t t-if="message == 'updated'">
                <div class="alert alert-success" role="alert">Dati del lead aggiornati.</div>
            </t>
            <t t-if="message == 'noted'">
                <div class="alert alert-success" role="alert">Nota aggiunta.</div>
            </t>
            <t t-if="errors">
                <div class="alert alert-danger" role="alert">
                    <ul class="mb-0">
                        <li t-foreach="errors" t-as="err" t-out="err"/>
                    </ul>
                </div>
            </t>

            <!-- Header + statusbar -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="mb-0" t-out="lead.name or 'Lead'"/>
                            <t t-call="qs2_crm_portal.lead_priority_stars"/>
                        </div>
                        <small class="text-muted">
                            Creato il <t t-out="lead.create_date" t-options="{'widget': 'date'}"/>
                        </small>
                    </div>
                    <div class="o_lead_statusbar">
                        <t t-foreach="stages" t-as="st">
                            <t t-set="reached" t-value="current_stage_index &gt;= 0 and st_index &lt;= current_stage_index"/>
                            <span class="badge rounded-pill"
                                  t-attf-class="#{('text-bg-success' if st.is_won else 'text-bg-primary') if reached else 'bg-light text-muted border'} #{'fw-bold' if st.id == lead.stage_id.id else ''}"
                                  t-out="st.name"/>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Form dati di contatto -->
            <form t-attf-action="/my/leads/#{lead.id}/save" method="post" class="o_portal_lead_form mb-4">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="card">
                    <div class="card-header fw-bold">Dati di contatto</div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="contact_name">Nome contatto</label>
                                <input type="text" class="form-control" id="contact_name" name="contact_name"
                                       t-att-value="form_values.get('contact_name')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="partner_name">Azienda</label>
                                <input type="text" class="form-control" id="partner_name" name="partner_name"
                                       t-att-value="form_values.get('partner_name')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="function">Ruolo</label>
                                <input type="text" class="form-control" id="function" name="function"
                                       t-att-value="form_values.get('function')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="qs2_initiative">Iniziativa</label>
                                <input type="text" class="form-control" id="qs2_initiative" name="qs2_initiative"
                                       t-att-value="form_values.get('qs2_initiative')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="email_from">Email</label>
                                <input type="email" name="email_from" id="email_from"
                                       t-attf-class="form-control #{'is-invalid' if 'email_from' in invalid_fields else ''}"
                                       t-att-value="form_values.get('email_from')"/>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="phone">Telefono</label>
                                <input type="text" class="form-control" id="phone" name="phone"
                                       t-att-value="form_values.get('phone')"/>
                            </div>
                        </div>
                        <hr/>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label" for="street">Indirizzo</label>
                                <input type="text" class="form-control mb-2" id="street" name="street"
                                       t-att-value="form_values.get('street')" placeholder="Via e numero"/>
                                <label class="visually-hidden" for="street2">Indirizzo (seconda riga)</label>
                                <input type="text" class="form-control" id="street2" name="street2"
                                       t-att-value="form_values.get('street2')" placeholder="Interno, scala, ..."/>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="city">Città</label>
                                <input type="text" class="form-control" id="city" name="city"
                                       t-att-value="form_values.get('city')"/>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="zip">CAP</label>
                                <input type="text" class="form-control" id="zip" name="zip"
                                       t-att-value="form_values.get('zip')"/>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="country_id">Paese</label>
                                <select class="form-select" id="country_id" name="country_id">
                                    <option value="">—</option>
                                    <t t-foreach="countries" t-as="country">
                                        <option t-att-value="country.id"
                                                t-att-selected="country.id == form_values.get('country_id')"
                                                t-out="country.name"/>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="state_id">Provincia</label>
                                <select class="form-select" id="state_id" name="state_id">
                                    <option value="">—</option>
                                    <t t-foreach="states" t-as="state">
                                        <option t-att-value="state.id"
                                                t-att-selected="state.id == form_values.get('state_id')"
                                                t-out="state.name"/>
                                    </t>
                                </select>
                                <small class="text-muted">Cambia paese e salva per aggiornare l'elenco province.</small>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <a href="/my/leads" class="btn btn-light">Annulla</a>
                        <button type="submit" class="btn btn-primary">Salva modifiche</button>
                    </div>
                </div>
            </form>

            <!-- Chatter: cronologia + nuova nota -->
            <div id="chatter" class="card">
                <div class="card-header fw-bold">
                    <i class="fa fa-comments-o me-1"/>Note e messaggi
                </div>
                <div class="card-body">
                    <form t-attf-action="/my/leads/#{lead.id}/note" method="post" class="mb-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label class="visually-hidden" for="note_body">Nuova nota</label>
                        <textarea name="note_body" id="note_body" class="form-control" rows="2"
                                  placeholder="Scrivi una nota sul lead..." required="required"/>
                        <div class="text-end mt-2">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-paper-plane me-1"/>Aggiungi nota
                            </button>
                        </div>
                    </form>

                    <div class="o_lead_chatter">
                        <t t-if="not messages">
                            <p class="text-muted mb-0">Nessun messaggio ancora.</p>
                        </t>
                        <t t-foreach="messages" t-as="msg">
                            <div class="o_lead_message">
                                <span class="o_lead_avatar" t-out="(msg.author_id.name or '?')[:1].upper()"/>
                                <div class="o_lead_message_body flex-grow-1">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="fw-semibold" t-out="msg.author_id.name or 'Sistema'"/>
                                        <small class="text-muted" t-out="msg.date" t-options="{'widget': 'datetime'}"/>
                                    </div>
                                    <div class="text-break" t-out="msg.body"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
